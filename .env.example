# 브라우저 번들에 그대로 들어가는 값이다. 비밀 값을 여기 넣지 않는다.
# 서비스 토큰, JWT 서명 키, DB 비밀번호는 절대 VITE_* 로 두지 않는다.

# 배포(Production)에서는 필수. API Origin 만 쓴다 (경로 /api/v1 은 코드가 붙인다).
# 예: https://api.example.com   (HTTPS 필수, 끝 슬래시/ /api/v1 불필요)
# 개발 중에는 비워 두면 아래 Vite proxy를 쓴다.
VITE_API_BASE_URL=

# 개발 서버가 /api 요청을 넘길 곳. 비밀이 아니다.
VITE_DEV_API_TARGET=http://127.0.0.1:8080
